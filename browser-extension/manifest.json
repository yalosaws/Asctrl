{
  "manifest_version": 3,
  "name": "Asctrl",
  "version": "0.1.0",
  "description": "Lets Asctrl, running on this computer, work web pages in this browser without the mouse.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "tabs", "nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Asctrl" }
}
