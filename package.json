{
  "name": "asctrl",
  "version": "0.2.0",
  "private": true,
  "description": "Computer-use framework: a driver that gives an AI eyes and hands on a Windows computer, an MCP server for any agent, and a relay for remote machines",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "relay": "node src/relay/server.ts",
    "mcp": "node src/console/mcp-server.ts",
    "mcp:http": "node src/console/mcp-http.ts",
    "keys": "node src/console/mcp-http.ts keys",
    "typecheck": "tsc",
    "test": "node --test test/regressions.ts && node test/e2e.ts",
    "test:sandbox": "node test/sandbox.ts",
    "test:http": "node test/http.ts",
    "bench": "node test/bench.ts",
    "timing": "node test/timing.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
